# Copy this file to .env.local and replace the value with the official WhatsApp number.
# Use the number without the leading + sign.
VITE_WHATSAPP_NUMBER=2348000000000

# Optional: enables the RLS-protected agent workspace. Use only the public anon key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key
